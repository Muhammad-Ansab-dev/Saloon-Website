# Copy to .env.local and fill in. .env.local is git-ignored.

# ── Database (PostgreSQL) ─────────────────────────────────────
# Required in production. In development the store falls back to the
# local dev database below when this is unset.
DATABASE_URL=postgres://salon:salon_dev_2026@localhost:5432/salon

# ── Admin dashboard auth ──────────────────────────────────────
# Required in production: without all three, login can never succeed
# and no session token will verify (fail closed). In development the
# values below are the built-in fallbacks.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=paul123
# Use a long random string, e.g. `openssl rand -hex 32`.
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Cloudinary (optional image uploads) ───────────────────────
# When all three of CLOUDINARY_CLOUD_NAME / API_KEY / API_SECRET are
# set, admin uploads go to Cloudinary instead of local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hair-salon
