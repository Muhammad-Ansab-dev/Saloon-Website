# Copy to .env.local and fill in. .env.local is git-ignored.

# ── Database (PostgreSQL) ─────────────────────────────────────
# Required in production. In development the store falls back to the
# local dev database below when this is unset.
DATABASE_URL=postgres://salon:salon_dev_2026@localhost:5432/salon

# ── Admin dashboard auth ──────────────────────────────────────
# Required in production: without all three, login can never succeed
# and no session token will verify (fail closed). In development the
# values below are the built-in fallbacks.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=paul123
# Use a long random string, e.g. `openssl rand -hex 32`.
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Branch manager accounts (seed) ────────────────────────────
# Each branch has its own username + password. A branch login lands on
# /dashboard/branch/<slug> and can only see that branch's data.
#
# These env vars only SEED the branch rows the first time the store is
# initialized. Afterwards the Branches tab in the dashboard is the source
# of truth: you create/edit/delete branches — including changing a branch
# manager's username/password — through the UI, and the stores's row wins
# over these vars. Production still requires setting them (fail closed
# at seed time). Dev fallbacks (unset): zurich/zurich123, paris/paris123.
BRANCH_ZURICH_USERNAME=zurich
BRANCH_ZURICH_PASSWORD=zurich123
BRANCH_PARIS_USERNAME=paris
BRANCH_PARIS_PASSWORD=paris123

# ── Cloudinary (optional image uploads) ───────────────────────
# When all three of CLOUDINARY_CLOUD_NAME / API_KEY / API_SECRET are
# set, admin uploads go to Cloudinary instead of local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hair-salon

# ── SMTP (confirmation emails) ────────────────────────────────
# When the admin confirms a booking, the customer receives a
# "Your booking is confirmed" email. Leave unset to skip sending.
# Works out of the box with a Gmail App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=<your gmail address>
#   SMTP_PASS=<16-char app password, NOT your account password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: override the From header (default "Paul Hair Studio <SMTP_USER>")
MAIL_FROM=
